import random

playerStats = {
"Health": 100,
"Damage": 15
}
enemyStats = {
"Health": 50,
"Damage": 10
}

def showStats():
  print("\nPlayerHealth:", playerStats["Health"])
  print("EnemyHealth:", enemyStats["Health"])

while True:
  showStats()

  action = input("Attack or Health").lower()

  if action == "attack":
    damage = random.randint(10, playerStats["Damage"])
    enemyStats["Health"] -= damage
    print("You dealt", damage, "damage")
    
  elif action == "health":
    health = random.randint(5, 15)
    playerStats["Health"] += health
    print("You gained", health, "health")

  if enemyStats["Health"] <= 0:
    print("You win")
    break

  enemyAction = random.randint(1, 2)

  if enemyAction == 1:
    enemyDamage = random.randint(5, enemyStats["Damage"])
    playerStats["Health"] -= damage
    print("You lost ", damage, "health")

  elif enemyAction == 2:
    enemyHealth = random.randint(1, 5)
    enemyStats["Health"] += health
    print("The enemy healed by", health, "health")

  if playerStats["Health"] <= 0:
    print("You lost")
    break
