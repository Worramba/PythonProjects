inventory = []
coins = 10

shop = {
   "Soda": 3,
   "Water": 1,
   "Fry": 5
}

def showInventory():
    print("Inventory:", inventory)

def buy(item):
    global coins
    if item in shop:
        price = shop[item]
        if coins >= price:
            coins -= price
            inventory.append(item)
            print("You bought", item)
            print("You have", coins, "left")
        else:
            print("Nope you cant buy it")
    else:
        print("This isn't an item")

while True:
    print("Hello welcome to my water shop")

    ifBuy = input("Would you like to buy yes/no? ")

    if ifBuy == "yes":
        choice = input("What would you like to buy? ")
        buy(choice)
    else:
        continue
