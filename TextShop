inventory = []
coins = 10

shop = [
  "Soda": 3,
  "Water": 1,
  "Fry": 5
]

print("Hello welcome to my water shop")

def buy(item)
  global coins

  if item in shop:
    price = shop[item]

    if item >= price:
      coins -= price
      inventory.append(item)
      print("You bought", item)
      print("You have", coins,"left")
    else
      print("Nope you cant buy it")
  else
    print("This isn't an item")

def showInvetory():
  print("Inventory", inventory)

showInventory()
buy("Fry")
